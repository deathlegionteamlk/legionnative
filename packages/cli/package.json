{
  "name": "@legion/cli",
  "version": "0.1.0",
  "description": "LEGION Native CLI - Command-line tools for Legion Native development",
  "type": "module",
  "bin": {
    "legion": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format cjs,esm --dts --clean --minify",
    "dev": "tsup src/cli.ts src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "ora": "^7.0.1",
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0",
    "prompts": "^2.4.2",
    "execa": "^8.0.1",
    "semver": "^7.5.4",
    "axios": "^1.6.0",
    "glob": "^10.3.10",
    "prettier": "^3.1.0",
    "esbuild": "^0.19.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.5.6",
    "eslint": "^8.55.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "legion",
    "native",
    "cli",
    "mobile",
    "react-native",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/legion-native/legion-native.git",
    "directory": "packages/cli"
  },
  "license": "MIT"
}
